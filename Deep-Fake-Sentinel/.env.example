# Required production secrets: replace SECRET_KEY and DB_PASSWORD before deployment.
SECRET_KEY=replace-with-a-long-random-production-secret
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=deepfake_sentinel
DB_USER=deepfake
DB_PASSWORD=replace-with-a-strong-password
DB_HOST=db
DB_PORT=5432

REDIS_URL=redis://redis:6379/0
# Optional Celery overrides; leave blank to derive both from REDIS_URL.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=False

MAX_UPLOAD_SIZE_MB=100
MEDIAPIPE_FACE_MODEL=
DJANGO_TEST_DB=False

LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30
